# Copy this file to /etc/teaching-assistant/app.env on the server.
# Fill every required empty value before running Docker Compose.

COMPOSE_PROJECT_NAME=teaching-assistant
STORAGE_HOST_PATH=/srv/teaching-assistant/storage

CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL_NAME=

EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL_NAME=Qwen/Qwen3-VL-Embedding-8B
EMBED_DIMENSION=4096
EMBED_BATCH_SIZE=32

VISION_API_KEY=
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_MODEL_NAME=Pro/moonshotai/Kimi-K2.6

MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=Discrete

REDIS_PASSWORD=

JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

QDRANT_COLLECTION_NAME=discrete_math_materials
QDRANT_MEMORY_COLLECTION_NAME=assistant_memories
TOP_K=3
MAX_TOKENS=2048
LOG_LEVEL=INFO

CHAT_CONTEXT_ENABLED=true
CONVERSATION_SUMMARY_ENABLED=true
MEMORY_WRITE_ENABLED=true
MEMORY_READ_ENABLED=false
CHAT_RECENT_MESSAGE_LIMIT=12
CHAT_RECENT_TOKEN_LIMIT=6000
CHAT_SUMMARY_TOKEN_LIMIT=1200
CHAT_MEMORY_TOKEN_LIMIT=1000
CHAT_OUTPUT_TOKEN_RESERVE=2000
MEMORY_RETRIEVAL_LIMIT=5
